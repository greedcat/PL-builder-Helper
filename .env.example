MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=Cluster0
MONGO_DB=Maple
PORT=3000
# fba-app saves each generated PL into the container's SharePoint folder.
# The key must equal PL_BUILDER_KEY on the fba-app service.
FBA_APP_URL=https://<fba-app host>
PL_BUILDER_KEY=<shared key>
